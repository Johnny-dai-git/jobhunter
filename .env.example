# DeepSeek API Key (https://platform.deepseek.com/) — 默认路由全走 DeepSeek
DEEPSEEK_API_KEY=sk-...

# Anthropic API Key (可选) — 只有当你在 config.yaml 把某个 role 的 provider 改回 claude 时才需要
# ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP 应用密码 (digest / trends 邮件用,不需要可留空)
SMTP_PASSWORD=

# Apify API Token (https://console.apify.com/account/integrations)
# 仅当 config.yaml 里某个平台 backend: apify 时才需要
APIFY_API_TOKEN=
